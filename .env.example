# Modèle du fichier .env. Copie-le en ".env" puis remplis les valeurs.
# Le fichier .env contient des secrets : ne le partage jamais, il est exclu de git.

# --- Twilio (WhatsApp) : https://console.twilio.com ---
TWILIO_ACCOUNT_SID=
# Dans une école : utilise une clé d'API propre à cette école (Console Twilio >
# Account > API keys & tokens > Create API key, type "Standard"), et laisse
# TWILIO_AUTH_TOKEN vide. Si le PC de l'école est compromis, tu révoques cette
# seule clé, sans exposer le compte entier ni les autres écoles.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Jeton principal du compte : seulement sur TON PC (tests, démos), jamais dans une école.
TWILIO_AUTH_TOKEN=
# Numéro WhatsApp expéditeur. Bac à sable (sandbox) Twilio : +14155238886
TWILIO_WHATSAPP_FROM=+14155238886
# Facultatif : identifiant du modèle de message approuvé (commence par HX).
# Obligatoire en production, voir le README.
TWILIO_CONTENT_SID=

# Numéro Twilio qui envoie les SMS (mode twilio_sms), au format +1xxxxxxxxxx.
TWILIO_SMS_FROM=

# --- Tableau de bord web ---
# Mot de passe de l'administration pour ouvrir le tableau de bord : 12 caractères
# minimum, différent dans chaque école (ex. une phrase : "Cour-du-lycee-a-7h40").
DASHBOARD_PASSWORD=

# --- Email au directeur (mode = "smtp" dans [directeur] de config.toml) ---
# Avec Gmail : active la validation en 2 étapes, puis crée un « mot de passe
# d'application » (myaccount.google.com > Sécurité). Ce n'est PAS le mot de passe du compte.
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# Facultatif (Gmail par défaut) :
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=465

# --- Pointeuse ZKTeco ---
# Mot de passe de communication (Comm Key) du boîtier, 0 par défaut.
ZK_MOT_DE_PASSE=0
