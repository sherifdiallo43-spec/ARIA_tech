# Modèle du fichier .env. Copie-le en ".env" puis remplis les valeurs.
# Le fichier .env contient des secrets : ne le partage jamais, il est exclu de git.

# --- WhatsApp, API Cloud de Meta : https://developers.facebook.com (ton app > WhatsApp) ---
# Jeton d'accès. Celui de la page « API Setup » expire au bout de 24 h (tests) ;
# en production, jeton permanent d'un utilisateur système (voir README).
META_JETON=
# « Phone number ID » du numéro qui envoie (page « API Setup »). Ce n'est PAS le
# numéro de téléphone lui-même.
META_ID_NUMERO=
# Facultatif : version de l'API Graph (v25.0 par défaut).
META_API_VERSION=

# --- Tableau de bord web ---
# Mot de passe de l'administration pour ouvrir le tableau de bord : 12 caractères
# minimum, différent dans chaque école (ex. une phrase : "Cour-du-lycee-a-7h40").
DASHBOARD_PASSWORD=

# --- Email au directeur (mode = "smtp" dans [directeur] de config.toml) ---
# Avec Gmail : active la validation en 2 étapes, puis crée un « mot de passe
# d'application » (myaccount.google.com > Sécurité). Ce n'est PAS le mot de passe du compte.
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# Facultatif (Gmail par défaut) :
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=465

# --- Pointeuse ZKTeco ---
# Mot de passe de communication (Comm Key) du boîtier, 0 par défaut.
ZK_MOT_DE_PASSE=0
